# Local config for the zero-shot classifier.
#
# This file is the template — copy it to `config.toml` (gitignored) and
# edit for your machine. Or have the model-advisor skill generate one for
# your GPU automatically (see .opencode/skills/model-advisor/SKILL.md).
#
#   cp config.toml.example config.toml
#
# Every key is optional: anything you leave commented falls back to the
# built-in default. Uncomment a line to set it.

model = "Qwen/Qwen3-VL-4B-Instruct"
# save_to = "models/qwen3-vl-4b-instruct"
# device = "auto"            # auto | cpu | gpu
# gpu = "rtx_5060_ti"        # which GPU when device = "gpu"
# quantize = "auto"          # auto | bf16 | fp32 | int8
# max_image_pixels = ""      # omit / "" = model native; cap helps on small GPUs
# kv_cache = true
# temperature = 1.0
# calibrate = true
# calibration_context = "N/A"
